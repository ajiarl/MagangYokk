generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model jobs {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  company         String
  location        String?
  is_remote       Boolean       @default(false)
  is_paid         Boolean?
  description     String?
  url             String        @unique
  source          String
  score           Decimal?      @db.Decimal(4, 2)
  score_breakdown Json?
  scraped_at      DateTime      @default(now()) @db.Timestamptz(6)
  expires_at      DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  applications    applications[]

  @@index([score(sort: Desc)])
  @@index([scraped_at(sort: Desc)])
  @@index([is_remote])
  @@index([source])
}

model seen_jobs {
  url        String   @id
  scraped_at DateTime @default(now()) @db.Timestamptz(6)
}

model profiles {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?       @db.Uuid
  full_name       String
  skills          String[]
  preferred_roles String[]
  location_pref   String?
  allow_remote    Boolean       @default(true)
  require_paid    Boolean       @default(false)
  score_threshold Decimal       @default(6.5) @db.Decimal(4, 2)
  portfolio_url   String?
  github_url      String?
  bio             String?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  applications    applications[]
}

model applications {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id              String             @db.Uuid
  profile_id          String             @db.Uuid
  status              application_status @default(saved)
  cover_letter_draft  String?
  cover_letter_lang   String             @default("id")
  applied_at          DateTime?          @db.Timestamptz(6)
  notes               String?
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @default(now()) @db.Timestamptz(6)
  job                 jobs               @relation(fields: [job_id], references: [id])
  profile             profiles           @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([job_id, profile_id])
  @@index([status])
  @@index([profile_id])
  @@index([job_id])
}

enum application_status {
  saved
  applied
  interview
  offered
  rejected
}
