# ==============================================================================
# MagangYokk - Environment Variables Template (.env.example)
# ==============================================================================
# Instruksi:
# 1. Salin berkas ini ke .env.local:
#    cp .env.example .env.local
# 2. Isi nilai placeholder di bawah dengan kredensial proyek Supabase & Groq Anda.
# 3. JANGAN PERNAH menyimpan kredensial produksi nyata ke git (.env.local sudah di-.gitignore).
# ==============================================================================

# URL Basis Aplikasi (Digunakan untuk metadata SEO & Origin verification)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Konfigurasi Supabase (Database PostgreSQL & REST API)
# Didapatkan di: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# URL endpoint REST Supabase (publik untuk client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Kunci API anon publik (aman digunakan di browser client jika RLS aktif)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# URL endpoint REST Supabase sisi server
SUPABASE_URL=https://your-project-ref.supabase.co

# PERINGATAN KEAMANAN: Kunci Service Role bersifat SANGAT RAHASIA (Bypass RLS).
# HANYA untuk runtime server-side (Server Actions, Route Handlers, dan server-only modules).
# JANGAN PERNAH menambahkan prefix NEXT_PUBLIC_ atau mengeksposnya ke sisi browser!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# ------------------------------------------------------------------------------
# AI Engine Groq Cloud (Llama 3.3 70B untuk Cover Letter & Resume Analysis)
# Didapatkan di: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_placeholder

# ------------------------------------------------------------------------------
# Keamanan Internal & Server Action Guard (Opsional tapi Direkomendasikan)
# Digunakan untuk validasi header x-action-secret pada pemanggilan internal/daemon.
# ------------------------------------------------------------------------------
INTERNAL_ACTION_SECRET=your-random-strong-secret-key-optional
